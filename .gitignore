# Save games: only the first three slots are part of the repo; any further
# slots (arbitrarily many, created in-game) stay local.
# [123] matches a single character, so e.g. slot_12.sav is still ignored.
saves/slot_*
!saves/slot_[123].sav
!saves/slot_[123]_thumb.png
# The autosave slot is always local
saves/autosave*

# Reference sheets generated by build_tools (inputs for image generation)
build_tools/output/
