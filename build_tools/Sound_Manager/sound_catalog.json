    "scroll_unroll": "Idea: opening info windows, contracts, menus",
    "ui_click_wood": "Idea: button clicks",
    "ui_confirm_wood": "Idea: OK / confirm",
    "ui_denied_thud": "Idea: refused, e.g. \"not enough money\". The source is slightly clipped (not audible at game volume)",
