    "amb_watermill_loop": "Idea: the mill from outside (wheel and water)",
    "book_close": "Idea: closing the ledger window",
    "book_open": "Idea: opening the ledger window",
    "chicken_alarm": "Idea: when the player walks into the flock",
    "chicken_cluck": "Idea: random farm clucks, the same pattern as the sheep",
