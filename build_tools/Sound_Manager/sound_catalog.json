    "coin_handful": "Idea: loans and large payments",
    "coin_pouch": "Idea: donations",
    "coin_single": "Idea: alms (a single coin), so not everything sounds like a market sale",
    "horse_cart_pass": "Idea: traders arriving or leaving town (24 s)",
